# ============================================================
# SEA Change Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql://postgres:password@localhost:5432/sea_dashboard

# ----- Frontend (Next.js) -----
# URL of the FastAPI backend — used by the Next.js app
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----- External Data APIs -----

# NewsAPI — free at https://newsapi.org/register
# Free tier: 100 req/day, English only
NEWSAPI_KEY=b7227f98456f44438917fa2eadafcdfa

# UN Comtrade — free subscription at https://comtradeplus.un.org
# Only needed for detailed bilateral trade data
COMTRADE_SUBSCRIPTION_KEY=your_comtrade_key_here

# ----- AI -----
# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model for AI explanations (cheapest option recommended for V1)
CLAUDE_MODEL=claude-haiku-4-5

# ----- App Settings -----
DEBUG=true
# CORS — comma-separated allowed origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:3000
